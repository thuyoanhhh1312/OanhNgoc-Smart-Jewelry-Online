# Environment Configuration Template
# Copy this file to .env and update the values as needed

# API Configuration
API_BASE_URL=http://oanhngocjewelry.online/api
API_TIMEOUT=30000

# Development/Production Mode  
APP_ENV=development

# Debug Configuration
ENABLE_LOGGING=true

# Network Configuration
CONNECT_TIMEOUT=5000
RECEIVE_TIMEOUT=30000

# Image Configuration
IMAGE_BASE_URL=http://oanhngocjewelry.online/uploads

# App Configuration
APP_NAME=Smart Jewelry
APP_VERSION=1.0.0

# Security Configuration
TOKEN_EXPIRE_TIME=3600
REFRESH_TOKEN_EXPIRE_TIME=86400

# Production Settings (uncomment and update for production)
# API_BASE_URL=https://your-production-api.com/api
# IMAGE_BASE_URL=https://your-production-api.com/uploads
# APP_ENV=production
# ENABLE_LOGGING=false
