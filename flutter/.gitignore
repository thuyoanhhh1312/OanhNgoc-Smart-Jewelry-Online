ios/Runner.xcworkspace/**
ios/Flutter/*.xcconfig
ios/Podfile
ios/Podfile.lock

# Node modules (if any)
node_modules/

# Temporary files
*.tmp
*.temp

# Log files
logs/

# Analysis cache
.dart_tool/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android related
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks

